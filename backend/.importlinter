[importlinter]
root_package = src

[importlinter:contract:layered-architecture]
name = Layered architecture
type = layers
layers =
    routers
    views
    services
    models
containers =
    src.modules.auth_profiles
    src.modules.appointments
    src.modules.doctors
    src.modules.medical_records
    src.modules.public
    src.modules.notification


[importlinter:contract:service-independence]
name = Service independence
type = independence
modules =
    src.modules.auth_profiles.services
    src.modules.appointments.services
    src.modules.doctors.services
    src.modules.medical_records.services
    src.modules.public.services
    src.modules.notification.services
ignore_imports =
    src.modules.appointments.services -> src.modules.public.services


[importlinter:contract:view-to-service]
name = Views independence
type = forbidden
source_modules =
    src.modules.auth_profiles.views
    src.modules.appointments.views
    src.modules.doctors.views
    src.modules.medical_records.views
    src.modules.public.views
    src.modules.notification.views
forbidden_modules =
    src.modules.auth_profiles.services
    src.modules.appointments.services
    src.modules.doctors.services
    src.modules.medical_records.services
    src.modules.public.services
    src.modules.notification.services
ignore_imports =
    src.modules.auth_profiles.views -> src.modules.auth_profiles.services
    src.modules.appointments.views -> src.modules.appointments.services
    src.modules.doctors.views -> src.modules.doctors.services
    src.modules.medical_records.views -> src.modules.medical_records.services
    src.modules.public.views -> src.modules.public.services
    src.modules.notification.views -> src.modules.notification.services